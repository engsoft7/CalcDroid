<?xml version="1.0" encoding="utf-8"?>
<!-- Widget de calculadora (RemoteViews). As teclas são ligadas em CalcWidget.kt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/widget_history"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="start"
        android:gravity="end"
        android:maxLines="1"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:textColor="#FFAAAAAA"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/widget_display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="start"
        android:gravity="end"
        android:maxLines="1"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:text="0"
        android:textColor="#FFEDEDED"
        android:textSize="32sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/k_c"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_key_gray"
            android:gravity="center"
            android:text="C"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp" />
        <TextView
            android:id="@+id/k_bs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_key_gray"
            android:gravity="center"
            android:text="⌫"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp" />
        <TextView
            android:id="@+id/k_pct"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_key_gray"
            android:gravity="center"
            android:text="%"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp" />
        <TextView
            android:id="@+id/k_div"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_key_op"
            android:gravity="center"
            android:text="÷"
            android:textColor="#FF000000"
            android:textSize="22sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/k_7"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_key_num"
            android:gravity="center"
            android:text="7"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp" />
        <TextView
            android:id="@+id/k_8"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_key_num"
            android:gravity="center"
            android:text="8"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp" />
        <TextView
            android:id="@+id/k_9"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_key_num"
            android:gravity="center"
            android:text="9"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp" />
        <TextView
            android:id="@+id/k_mul"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_key_op"
            android:gravity="center"
            android:text="×"
            android:textColor="#FF000000"
            android:textSize="22sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/k_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_key_num"
            android:gravity="center"
            android:text="4"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp" />
        <TextView
            android:id="@+id/k_5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_key_num"
            android:gravity="center"
            android:text="5"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp" />
        <TextView
            android:id="@+id/k_6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_key_num"
            android:gravity="center"
            android:text="6"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp" />
        <TextView
            android:id="@+id/k_sub"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_key_op"
            android:gravity="center"
            android:text="−"
            android:textColor="#FF000000"
            android:textSize="22sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/k_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_key_num"
            android:gravity="center"
            android:text="1"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp" />
        <TextView
            android:id="@+id/k_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_key_num"
            android:gravity="center"
            android:text="2"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp" />
        <TextView
            android:id="@+id/k_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_key_num"
            android:gravity="center"
            android:text="3"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp" />
        <TextView
            android:id="@+id/k_add"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_key_op"
            android:gravity="center"
            android:text="+"
            android:textColor="#FF000000"
            android:textSize="22sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/k_open"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_key_gray"
            android:gravity="center"
            android:text="↗"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp" />
        <TextView
            android:id="@+id/k_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_key_num"
            android:gravity="center"
            android:text="0"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp" />
        <TextView
            android:id="@+id/k_dot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_key_num"
            android:gravity="center"
            android:text="."
            android:textColor="#FFFFFFFF"
            android:textSize="22sp" />
        <TextView
            android:id="@+id/k_eq"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_key_op"
            android:gravity="center"
            android:text="="
            android:textColor="#FF000000"
            android:textSize="22sp" />
    </LinearLayout>
</LinearLayout>
